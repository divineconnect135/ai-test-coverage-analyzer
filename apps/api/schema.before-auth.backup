generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------
// ENUMS
// --------------------------------------------------

enum TestCaseType {
  POSITIVE
  NEGATIVE
  EDGE_CASE
  SECURITY
  OTHER
}

enum TestCaseStatus {
  DRAFT
  READY
  COMPLETED
}

enum AnalysisStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SuggestionPriority {
  LOW
  MEDIUM
  HIGH
}

// --------------------------------------------------
// USER
// --------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects Project[]
}

// --------------------------------------------------
// PROJECT
// --------------------------------------------------

model Project {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements Requirement[]
  testCases    TestCase[]
  analyses     AnalysisRun[]

  @@index([userId, updatedAt])
}

// --------------------------------------------------
// REQUIREMENT
// --------------------------------------------------

model Requirement {
  id          String   @id @default(uuid())
  projectId   String
  code        String
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases TestCaseRequirement[]

  @@unique([projectId, code])
  @@index([projectId])
}

// --------------------------------------------------
// TEST CASE
// --------------------------------------------------

model TestCase {
  id                 String         @id @default(uuid())
  projectId          String
  title              String
  description        String         @default("")
  type               TestCaseType   @default(OTHER)
  status             TestCaseStatus @default(DRAFT)
  steps              String[]       @default([])
  expectedResult     String         @default("")
  sourceSuggestionId String?        @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirements     TestCaseRequirement[]
  sourceSuggestion AnalysisSuggestion?   @relation("SavedFromSuggestion", fields: [sourceSuggestionId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

// --------------------------------------------------
// TEST CASE ↔ REQUIREMENT
// --------------------------------------------------

model TestCaseRequirement {
  testCaseId    String
  requirementId String

  testCase    TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@id([testCaseId, requirementId])
  @@index([requirementId])
}

// --------------------------------------------------
// AI ANALYSIS RUN
// --------------------------------------------------

model AnalysisRun {
  id                     String         @id @default(uuid())
  projectId              String
  status                 AnalysisStatus @default(PENDING)
  model                  String?
  inputSnapshot          Json
  resultSummary          String?
  requirementAssessments Json?
  limitations            Json?
  errorCode              String?
  inputTokens            Int?
  outputTokens           Int?
  createdAt              DateTime       @default(now())
  completedAt            DateTime?

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suggestions AnalysisSuggestion[]

  @@index([projectId, createdAt])
}

// --------------------------------------------------
// AI ANALYSIS SUGGESTION
// --------------------------------------------------

model AnalysisSuggestion {
  id                    String             @id @default(uuid())
  analysisRunId         String
  title                 String
  description           String
  type                  TestCaseType       @default(OTHER)
  priority              SuggestionPriority @default(MEDIUM)
  reason                String
  steps                 String[]           @default([])
  expectedResult        String
  relatedRequirementIds String[]           @default([])
  createdAt             DateTime           @default(now())

  analysisRun   AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  savedTestCase TestCase?   @relation("SavedFromSuggestion")

  @@index([analysisRunId])
}
